{
  "name": "premium-download-manager",
  "version": "4.1.0",
  "description": "Premium Download Manager - أسرع وأنيق مثل IDM وأكثر",
  "main": "src/main/main.js",
  "author": "PremiumDM",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always",
    "clean": "node scripts/clean.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "publish": {
    "provider": "github",
    "owner": "jokertools12",
    "repo": "premium-download-manager"
  },
  "build": {
    "appId": "org.premiumdm.app",
    "productName": "Premium Download Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "src/extension",
        "to": "extension",
        "filter": [
          "**/*",
          "!install.bat"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/webtorrent/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip",
        "portable"
      ],
      "artifactName": "PremiumDM-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "PremiumDM-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "PremiumDM <jokertools12@users.noreply.github.com>",
      "artifactName": "PremiumDM-${version}-linux.${ext}"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Premium Download Manager",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "PremiumDM-Setup-${version}.${ext}",
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ]
    },
    "portable": {
      "artifactName": "PremiumDM-PortableSingle-${version}.${ext}"
    }
  },
  "devDependencies": {
    "better-sqlite3": "^13.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "basic-ftp": "^6.2.1",
    "electron-updater": "^6.8.9",
    "webtorrent": "^3.0.21"
  }
}
