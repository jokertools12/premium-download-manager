{
  "name": "premium-download-manager",
  "version": "1.0.2",
  "description": "Premium Download Manager - أسرع وأنيق مثل IDM وأكثر",
  "main": "src/main/main.js",
  "author": "PremiumDM",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always",
    "clean": "node scripts/clean.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "publish": {
    "provider": "github",
    "owner": "jokertools12",
    "repo": "premium-download-manager"
  },
  "build": {
    "appId": "org.premiumdm.app",
    "productName": "Premium Download Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "src/extension",
        "to": "extension",
        "filter": [
          "**/*",
          "!install.bat"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/webtorrent/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "PremiumDM-Setup-${version}.${ext}"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "better-sqlite3": "^13.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "webtorrent": "^3.0.21"
  }
}
